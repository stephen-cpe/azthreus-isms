# Copy this file to .env.local and fill in your values.
#   PowerShell:  Copy-Item .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
#
# The app does not create the database. Create the role and database named in
# README.md first, then run init_db.sql as the owner of that database.

# PostgreSQL connection string. The database must be azthreus_isms unless you
# also update the setup steps and .env.local together.
DATABASE_URL=postgresql://isms_user:isms_pass@localhost:5432/azthreus_isms

# Secret used to sign the session cookie. At least 32 characters are required
# in production; development uses a fixed fallback with a one-time warning.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
